# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (matches docker-compose.yml defaults or standalone MySQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=personal_money_tracker
DATABASE_USER=money_tracker
DATABASE_PASSWORD=replace_with_strong_password
DATABASE_ROOT_PASSWORD=replace_with_strong_root_password
DATABASE_CONNECTION_LIMIT=10

# JWT Security (Must be at least 32 characters in production)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-secure-random-token
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# CORS Origins (comma separated list of allowed origins, or * for open mobile API)
CORS_ORIGINS=*
